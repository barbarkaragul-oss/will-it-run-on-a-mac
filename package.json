{
  "name": "will-it-run-on-a-mac",
  "version": "0.1.0",
  "private": true,
  "description": "Paste a shell script, see every flag that breaks on macOS or BusyBox, proven by that platform's own man page and a real run.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "will-it-run-on-a-mac": "bin/wiroam.js"
  },
  "scripts": {
    "extract": "tsx scripts/extract.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test \"tests/*.test.ts\"",
    "extract-shells": "tsx scripts/extract-shells.ts",
    "build:action": "tsx scripts/build-action.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/barbarkaragul-oss/will-it-run-on-a-mac"
  },
  "license": "MIT",
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@actions/glob": "^0.7.0",
    "@types/node": "^22.20.2",
    "esbuild": "^0.28.2",
    "tree-sitter-bash": "^0.25.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "web-tree-sitter": "^0.27.0"
  }
}
